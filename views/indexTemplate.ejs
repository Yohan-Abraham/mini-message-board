<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mini Message Board</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

        <h1 class="title">Mini Message Board</h1>
        <a href="/new">New Message</a>

    <section class="messages">
        <% for(let i = 0; i < message.length; i++){ %>
            <div class="message-container">
            <div class="message">
                <h2><%= message[i].message %></h2>
                <h4 class="author">by <%= message[i].author %></h4>
                <h4 class="date"><%= message[i].date %></h4>
            </div>
                    <form id="delete-form" action="/delete/<%= message[i].id %>" method="POST">
          <button type="submit">Delete</button>
        </form>
        </div>
        <% } %>
    </section>
</body>
